{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheaf.org/schemas/opensheaf-object-0.1.schema.json",
  "title": "OpenSheaf object record (object.json), format opensheaf-object/0.1",
  "$comment": "Part of OpenSheaf 0.1 (https://opensheaf.org). Dedicated to the public domain under CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/",
  "type": "object",
  "required": [
    "format",
    "specification",
    "kind",
    "archiveId",
    "objectId",
    "documentVersion",
    "status"
  ],
  "properties": {
    "format": {
      "const": "opensheaf-object/0.1"
    },
    "specification": {
      "const": "0.1"
    },
    "kind": {
      "enum": [
        "document",
        "collection"
      ]
    },
    "archiveId": {
      "type": "string",
      "format": "uri"
    },
    "objectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "documentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "mainSource": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!(?:.*/)?\\.{1,2}(?:/|$)).+$"
    },
    "sourceFormat": {
      "type": "string",
      "minLength": 1
    },
    "sourcesMissing": {
      "$ref": "#/$defs/note"
    },
    "renditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "mediaType"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!(?:.*/)?\\.{1,2}(?:/|$)).+$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "toolchain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "changes": {
      "$ref": "#/$defs/note"
    },
    "stage": {
      "type": "object",
      "required": [
        "scheme",
        "value"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/objectVersion"
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/note"
          },
          {
            "type": "object",
            "required": [
              "documentVersion",
              "date"
            ],
            "properties": {
              "documentVersion": {
                "type": "integer",
                "minimum": 1
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        ]
      }
    },
    "licence": {
      "$ref": "#/$defs/note"
    },
    "agreement": {
      "type": "object",
      "required": [
        "by",
        "date",
        "method"
      ],
      "properties": {
        "by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "external": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "service",
          "record"
        ],
        "properties": {
          "role": {
            "enum": [
              "deposit",
              "source"
            ]
          },
          "service": {
            "type": "string"
          },
          "record": {
            "type": "string",
            "format": "uri"
          },
          "doi": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "sha512"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "sha512": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{128}$"
                },
                "md5": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "bytes": {
                  "type": "integer"
                }
              }
            }
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "withdrawn"
      ]
    },
    "withdrawal": {
      "type": "object",
      "required": [
        "date",
        "reason"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "format": "uri",
        "minLength": 1
      },
      "additionalProperties": true
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z2-7]{51}[aq]$",
      "$comment": "proposal (section 6.5): 256 bits of the SHA-512 digest of genesis.json, lowercase base32"
    },
    "owner": {
      "type": "string",
      "format": "uri",
      "$comment": "proposal (section 6.5): a named owner (archive identifier, ORCID iD, web address) or a keyed owner (did:key:, openpgp4fpr:)"
    },
    "parent": {
      "type": "object",
      "$comment": "proposal (section 10.5): the parent version of a branch",
      "required": [
        "owner",
        "name",
        "archiveId",
        "objectId",
        "objectVersion",
        "documentVersion",
        "inventorySha512"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "format": "uri",
          "$comment": "proposal (section 6.5): a named owner (archive identifier, ORCID iD, web address) or a keyed owner (did:key:, openpgp4fpr:)"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z2-7]{51}[aq]$",
          "$comment": "proposal (section 6.5): 256 bits of the SHA-512 digest of genesis.json, lowercase base32"
        },
        "archiveId": {
          "type": "string",
          "format": "uri"
        },
        "objectId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "objectVersion": {
          "$ref": "#/$defs/objectVersion"
        },
        "documentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "inventorySha512": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!(?:.*/)?\\.{1,2}(?:/|$)).+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "path"
          ]
        }
      ],
      "dependentRequired": {
        "path": [
          "mediaType"
        ]
      }
    },
    "objectVersion": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "document"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "mainSource",
              "sourceFormat"
            ]
          },
          {
            "required": [
              "sourcesMissing",
              "renditions"
            ],
            "properties": {
              "renditions": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "withdrawn"
          }
        }
      },
      "then": {
        "required": [
          "withdrawal"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "collection"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "mainSource"
              ]
            },
            {
              "required": [
                "sourceFormat"
              ]
            },
            {
              "required": [
                "sourcesMissing"
              ]
            },
            {
              "required": [
                "renditions"
              ]
            },
            {
              "required": [
                "toolchain"
              ]
            },
            {
              "required": [
                "changes"
              ]
            },
            {
              "required": [
                "stage"
              ]
            },
            {
              "required": [
                "history"
              ]
            },
            {
              "required": [
                "notices"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "sourcesMissing"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "mainSource"
              ]
            },
            {
              "required": [
                "sourceFormat"
              ]
            }
          ]
        }
      }
    }
  ],
  "dependentRequired": {
    "name": [
      "owner"
    ],
    "parent": [
      "name",
      "owner"
    ],
    "owner": [
      "name"
    ]
  }
}
